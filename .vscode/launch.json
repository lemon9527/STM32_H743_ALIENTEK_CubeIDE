{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cortex Debug (OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceRoot}",
      "executable": "${workspaceRoot}/Debug/STM32_H743_ALIENTEK_CubeIDE.elf",
      "device": "STM32H743xx",
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/stm32h7x.cfg"
      ],
      "openOCDPath": "/opt/homebrew/bin/openocd",
      "runToEntryPoint": "main",
      "svdFile": "",
      
    }
  ]
}
